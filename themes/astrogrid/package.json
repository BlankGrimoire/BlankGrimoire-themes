{
  "name": "@blankgrimoire/theme-astrogrid",
  "version": "0.1.0",
  "description": "Grid library theme adapter for statically generated content sites",
  "blankgrimoire": {
    "adapterId": "theme.astrogrid",
    "adapterName": "Astro Grid Theme"
  },
  "type": "module",
  "main": "dist/runtime.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/prepare-dist.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "manifest": "pnpm build && node ../../scripts/build-adapter-manifest.mjs"
  },
  "keywords": [
    "blankgrimoire",
    "theme",
    "grid",
    "chapter-list",
    "reader"
  ],
  "author": "BlankGrimoire",
  "license": "MIT",
  "devDependencies": {
    "@blankgrimoire/runtime": "^1.4.0",
    "@blankgrimoire/testing": "^1.4.0",
    "@blankgrimoire/types": "^1.4.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "@blankgrimoire/types": "^1.4.0"
  }
}
