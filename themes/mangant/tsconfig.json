{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@blankgrimoire/types": ["../../../BlankGrimoire-sdk/packages/types/src/index.ts"]
    }
  },
  "include": ["*.ts", "*.js"],
  "exclude": ["node_modules", "dist"]
}