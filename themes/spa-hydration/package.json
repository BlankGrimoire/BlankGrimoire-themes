{
  "name": "@blankgrimoire/theme-spa-hydration",
  "version": "1.0.0",
  "private": true,
  "description": "Declarative adapter for SPA hydration payloads.",
  "blankgrimoire": {
    "adapterId": "theme.spa-hydration",
    "adapterName": "SPA Hydration Theme"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-adapter-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "manifest": "pnpm build && node ../../scripts/build-adapter-manifest.mjs"
  },
  "dependencies": {
    "@blankgrimoire/types": "1.0.1"
  },
  "devDependencies": {
    "@blankgrimoire/cli": "1.0.1",
    "@blankgrimoire/runtime": "1.0.1",
    "@blankgrimoire/testing": "1.0.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
